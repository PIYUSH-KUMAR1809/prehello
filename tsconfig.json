{
  "compilerOptions": {
    "target": "ES2022",
    "newLine": "lf",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": false,
    "declaration": false,
    "sourceMap": false,
    "noUnusedLocals": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts"
  ]
}